generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String?
  email         String         @unique
  passwordHash  String?
  phone         String?        @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  image         String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  addresses     Address[]
  birthProfile  BirthProfile?
  blogs         Blog[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model VerificationToken {
  id         String    @id @default(uuid())
  identifier String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
  @@map("verification_tokens")
}

model Category {
  id                           String                         @id @default(uuid())
  name                         String
  slug                         String                         @unique
  image                        String
  sortOrder                    Int                            @default(0)
  pageContent                  Json
  isActive                     Boolean                        @default(true)
  bannerImage                  String?
  description                  String?
  displayType                  CategoryDisplayType            @default(SUBCATEGORY_LANDING)
  isFeatured                   Boolean                        @default(false)
  parentId                     String?
  seoDescription               String?
  seoTitle                     String?
  thumbnailImage               String?
  blogs                        Blog[]
  categories                   Category?                      @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories             Category[]                     @relation("categoriesTocategories")
  product_category_assignments product_category_assignments[]
  products                     Product[]                      @relation("PrimaryCategory")
  subcategories                Subcategory[]

  @@map("categories")
}

model Subcategory {
  id                           String                         @id @default(uuid())
  name                         String
  slug                         String
  image                        String
  group                        String?
  sortOrder                    Int                            @default(0)
  categoryId                   String
  product_category_assignments product_category_assignments[]
  products                     Product[]
  category                     Category                       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

model Collection {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  icon      String
  sortOrder Int       @default(0)
  products  Product[] @relation("CollectionToProduct")

  @@map("collections")
}

model Product {
  id                           String                         @id @default(uuid())
  slug                         String                         @unique
  name                         String
  breadcrumbLabel              String
  categoryId                   String
  description                  String
  shippingInfo                 String
  packagingInfo                String
  returnsInfo                  String
  priceCents                   Int
  compareAtPriceCents          Int?
  stockCount                   Int                            @default(0)
  ratingAvg                    Float                          @default(0)
  ratingCount                  Int                            @default(0)
  isBestseller                 Boolean                        @default(false)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  certified                    Boolean                        @default(false)
  chakra                       String?
  energized                    Boolean                        @default(false)
  gemstoneType                 String?
  mukhi                        Int?
  origin                       String?
  planet                       String?
  sizeMm                       Float?
  subcategoryId                String?
  weightGrams                  Float?
  zodiac                       String?
  cartItems                    CartItem[]
  inspiredItems                InspiredItem[]
  orderItems                   OrderItem[]
  addOns                       ProductAddOn[]
  product_category_assignments product_category_assignments[]
  images                       ProductImage[]
  sizes                        ProductSize[]
  variants                     ProductVariant[]
  category   Category @relation("PrimaryCategory", fields: [categoryId], references: [id])

  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  reviews                      Review[]
  wishlistItems                WishlistItem[]
  collections                  Collection[]                   @relation("CollectionToProduct")

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isBestseller])
  @@map("products")
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  url       String
  alt       String
  role      ProductImageRole
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String     @id @default(uuid())
  productId       String
  label           String
  priceDeltaCents Int        @default(0)
  image           String
  sortOrder       Int        @default(0)
  cartItems       CartItem[]
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductAddOn {
  id              String     @id @default(uuid())
  productId       String
  label           String
  priceDeltaCents Int        @default(0)
  sortOrder       Int        @default(0)
  cartItems       CartItem[]
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_addons")
}

model ProductSize {
  id        String     @id @default(uuid())
  productId String
  label     String
  sortOrder Int        @default(0)
  cartItems CartItem[]
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_sizes")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String?
  authorName String
  title      String
  body       String
  rating     Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model Blog {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  excerpt         String
  body            String
  coverImage      String
  author          String     @default("Rudraksha Antiquei")
  readTimeMinutes Int        @default(5)
  categoryId      String?
  publishedAt     DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  authorId        String?
  metaDescription String?
  metaTitle       String?
  status          BlogStatus @default(PUBLISHED)
  tags            String[]   @default([])
  coverImageAlt   String?
  authorUser      User?      @relation(fields: [authorId], references: [id])
  category        Category?  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([publishedAt])
  @@index([status])
  @@index([authorId])
  @@map("blogs")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  addOnId   String?
  sizeId    String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  addOn     ProductAddOn?   @relation(fields: [addOnId], references: [id])
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      ProductSize?    @relation(fields: [sizeId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model BirthProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  fullName       String
  dob            String
  tob            String?
  timeNotSure    Boolean  @default(false)
  lifePathNumber Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model ConsultationRequest {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  dob             String
  tob             String
  pob             String
  appointmentDate String
  kundaliUrl      String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("consultation_requests")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Banner {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  title          String
  titleHighlight String?
  subtitle       String?
  imageUrl       String
  ctaText        String   @default("SHOP NOW")
  ctaLink        String   @default("#")
  gradientFrom   String?  @default("#298FC2")
  gradientTo     String?  @default("#FFFFFF")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("banners")
}

model InspiredItem {
  id              String   @id @default(uuid())
  title           String
  type            String   @default("video")
  videoUrl        String?
  imageUrl        String
  productImageUrl String?
  price           String?
  originalPrice   String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])

  @@map("inspired_items")
}

model Order {
  id                String            @id @default(uuid())
  userId            String
  addressId         String?
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?
  status            OrderStatus       @default(PENDING)
  totalCents        Int
  currency          String            @default("INR")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  fulfillmentStatus FulfillmentStatus @default(PLACED)
  paidAt            DateTime?
  events            OrderEvent[]
  items             OrderItem[]
  address           Address?          @relation(fields: [addressId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderEvent {
  id        String            @id @default(uuid())
  orderId   String
  status    FulfillmentStatus
  note      String?
  createdAt DateTime          @default(now())
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  priceCents   Int
  createdAt    DateTime @default(now())
  addOnLabel   String?
  productName  String?
  sizeLabel    String?
  variantLabel String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model product_category_assignments {
  id            String       @id
  productId     String
  categoryId    String
  subcategoryId String?
  createdAt     DateTime     @default(now())
  categories    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcategories Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@unique([productId, categoryId, subcategoryId])
  @@index([categoryId])
  @@index([subcategoryId])
}

enum Role {
  CUSTOMER
  ADMIN
  WRITER
}

enum BlogStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_OTP
}

enum ProductImageRole {
  MAIN
  GALLERY_LEFT
  GALLERY_TOP_RIGHT
  GALLERY_BOTTOM_RIGHT
  EXTRA
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  PLACED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CategoryDisplayType {
  SUBCATEGORY_LANDING
  PRODUCT_LISTING
}
