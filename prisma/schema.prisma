// Prisma schema for Rudraksh e-commerce auth + user data
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  WRITER
  ADMIN
}

enum BlogStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_OTP
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  phone         String?   @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  addresses     Address[]
  reviews       Review[]
  cart          Cart?
  wishlistItems WishlistItem[]
  birthProfile  BirthProfile?
  blogs         Blog[]

  @@map("users")
}

// NextAuth-compatible model for linking OAuth providers (Google, etc.)
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Generic token store reused for email verification, password reset,
// and (Phase 3) email OTP login codes.
model VerificationToken {
  id         String    @id @default(uuid())
  identifier String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------
// Product catalog
// ---------------------------------------------------------------------

// Primary product category — drives the Header "Products" mega-menu and
// the /products/category/[slug] listing page (hero, intro, checklist,
// and fit-check sections all come from `pageContent`).
model Category {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  image     String
  sortOrder Int    @default(0)

  // Shape: { heroTitle, heroSubtitle, introHeading, introDescription,
  // introImage, checklistHeading, checklist: string[5], checklistImages: [string, string],
  // fitCheckRightLabel, fitCheckRightItems: string[3],
  // fitCheckWrongLabel, fitCheckWrongItems: string[3], fitCheckImage }
  pageContent Json

  products      Product[]
  blogs         Blog[]
  subcategories Subcategory[]

  @@map("categories")
}

// A "type" within a Category (e.g. "5 Mukhi Rudraksha" under "Rudraksha").
// `group` is an optional visual heading used to cluster subcategories on the
// category landing page (e.g. "Rudraksha Bracelets" vs "Gemstone Bracelets").
model Subcategory {
  id        String  @id @default(uuid())
  name      String
  slug      String
  image     String
  group     String?
  sortOrder Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

// "Shop By Purpose" tags (Wealth, Health, Love, ...) — a many-to-many
// "sub category" on top of the primary Category.
model Collection {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  icon      String
  sortOrder Int    @default(0)

  products Product[]

  @@map("collections")
}

model Product {
  id              String @id @default(uuid())
  slug            String @unique
  name            String
  breadcrumbLabel String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  description   String @db.Text
  shippingInfo  String @db.Text
  packagingInfo String @db.Text
  returnsInfo   String @db.Text

  priceCents          Int
  compareAtPriceCents Int?

  stockCount   Int     @default(0)
  ratingAvg    Float   @default(0)
  ratingCount  Int     @default(0)
  isBestseller Boolean @default(false)

  // ── Filter attributes ("Pro Tip" facets). All optional / category-specific.
  // Purpose is modelled by the many-to-many `collections`; availability is
  // derived from `stockCount`.
  mukhi        Int? // Rudraksha faces (null for Gauri Shankar / non-rudraksha)
  origin       String? // Nepal | Indonesia | India | ...
  gemstoneType String? // Ruby | Emerald | ... (gemstone products)
  certified    Boolean @default(false) // Lab Certified
  energized    Boolean @default(false) // Energized vs Non-Energized
  weightGrams  Float?
  sizeMm       Float?
  zodiac       String?
  planet       String? // Navagraha
  chakra       String?

  images        ProductImage[]
  variants      ProductVariant[]
  addOns        ProductAddOn[]
  sizes         ProductSize[]
  reviews       Review[]
  collections   Collection[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isBestseller])
  @@map("products")
}

enum ProductImageRole {
  MAIN
  GALLERY_LEFT
  GALLERY_TOP_RIGHT
  GALLERY_BOTTOM_RIGHT
  EXTRA
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  role      ProductImageRole
  sortOrder Int              @default(0)

  @@index([productId])
  @@map("product_images")
}

// "Select Your Design" options (Loose Bead, Silver Capped, ...)
model ProductVariant {
  id              String  @id @default(uuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String
  priceDeltaCents Int     @default(0)
  image           String
  sortOrder       Int     @default(0)

  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

// "Select Energization" options
model ProductAddOn {
  id              String  @id @default(uuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String
  priceDeltaCents Int     @default(0)
  sortOrder       Int     @default(0)

  cartItems CartItem[]

  @@index([productId])
  @@map("product_addons")
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int     @default(0)

  cartItems CartItem[]

  @@index([productId])
  @@map("product_sizes")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  title      String
  body       String   @db.Text
  rating     Int
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------

model Blog {
  id              String  @id @default(uuid())
  slug            String  @unique
  title           String
  excerpt         String  @db.Text
  body            String  @db.Text
  coverImage      String
  coverImageAlt   String?
  author          String  @default("Rudraksha Antiquei")
  readTimeMinutes Int     @default(5)

  status          BlogStatus @default(PUBLISHED)
  tags            String[]   @default([])
  metaTitle       String?
  metaDescription String?    @db.Text

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // The staff member (writer/admin) who created the post. Free-text `author`
  // remains the byline shown to readers.
  authorId   String?
  authorUser User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([publishedAt])
  @@index([status])
  @@index([authorId])
  @@map("blogs")
}

// ---------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  addOnId String?
  addOn   ProductAddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  sizeId String?
  size   ProductSize? @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------

model WishlistItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------
// Birth Profile (Rudraksha recommendation)
// ---------------------------------------------------------------------

// Stores a logged-in user's birth details and the computed Life Path
// Number so their Rudraksha recommendation persists across visits.
// Guests keep the same shape in localStorage until they log in.
model BirthProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  dob            String
  tob            String?
  timeNotSure    Boolean @default(false)
  lifePathNumber Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("birth_profiles")
}

// ---------------------------------------------------------------------
// Consultation Requests
// ---------------------------------------------------------------------

model ConsultationRequest {
  id              String @id @default(uuid())
  name            String
  email           String
  phone           String
  dob             String
  tob             String
  pob             String
  appointmentDate String
  kundaliUrl      String

  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consultation_requests")
}
